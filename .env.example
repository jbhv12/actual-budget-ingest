# Copy to .env and fill in. .env is gitignored.
#
# For local docker-compose. For production, set these via `fly secrets set`.

# --- Actual Budget server + API wrapper ------------------------------
# Password used by both the server (bootstrap/login) and the API wrapper
# (to log in and sync). Pick a strong value; this is NOT the login for the
# UI if your Actual server is already bootstrapped — in that case, use the
# existing password.
ACTUAL_PASSWORD=

# The budget "sync id" (= groupId from /sync/list-user-files).
# To obtain after a budget exists on the server:
#   TOKEN=$(curl -s -X POST http://localhost:5006/account/login \
#     -H 'Content-Type: application/json' -d "{\"password\":\"$ACTUAL_PASSWORD\"}" \
#     | jq -r .data.token)
#   curl -s http://localhost:5006/sync/list-user-files \
#     -H "x-actual-token: $TOKEN" | jq '.data[].groupId'
ACTUAL_SYNC_ID=

# --- Ingest pipeline -------------------------------------------------
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# HDFC statement PDF password. HDFC's convention: first 4 letters of
# customer name (uppercase) + DDMM of DOB. e.g. JOHN0105 for John born 1 May.
# Confirm against the hint in your statement email.
HDFC_PDF_PASSWORD=

# Ingest input source. 'folder' watches /data/pdfs (default, v1).
# 'gmail' uses the Gmail connector (v2, not yet implemented).
INGEST_SOURCE=folder

# --- Gmail connector (v2, optional) ----------------------------------
# Fill in after running `scripts/get-gmail-refresh-token.sh`.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL=actual-ingest
GMAIL_POLL_INTERVAL_SEC=900
